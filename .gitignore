# Raw sample captures are immutable inputs and too large for Git (~670 MB).
# The directory name really ends with a space; the backslash keeps it.
/example input\ /
# Local PDF render scratch from planning.
/tmp/
.DS_Store

# Python and uv (.venv is a symlink to .venv.nosync on macOS; see scripts/bootstrap.sh)
.venv
.venv.nosync/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Ad-hoc local result directories (benchmark evidence lives under runs/).
/outputs/

# Model checkpoints (several GB) are fetched by scripts/fetch_models.sh.
/models/

# Assignment source documents stay local; configs/gates.yaml pins their hashes.
/Applied_AI_Case_Study.pdf
/applied_ai_case_study_engineering_prd.pdf
# Planning handoff stays local (derived from the assignment documents).
/docs/implementation-strategy/

# Raw benchmark captures and tape sheets (benchmark/ground_truth/protocol.md).
/data/

# Per-frame inspection rows are large (about 10 MB per sample session);
# runs/*/frames-sha256.txt records their hashes.
/runs/**/frames.jsonl
# Reconstruction arrays and previews are large (100s of MB per sample run);
# runs/*/reconstruction/bundle.json lists each one by content hash.
/runs/**/reconstruction/submaps/
/runs/**/reconstruction/preview.ply
