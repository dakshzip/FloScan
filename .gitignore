.venv
.venv.nosync/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Ad-hoc local result directories (benchmark evidence lives under runs/).
/outputs/

# Model checkpoints (several GB) are fetched by scripts/fetch_models.sh.
/models/

# Assignment source documents stay local; configs/gates.yaml pins their hashes.
/Applied_AI_Case_Study.pdf
/applied_ai_case_study_engineering_prd.pdf
# Planning handoff stays local (derived from the assignment documents).
/docs/implementation-strategy/
